{
  "name": "trackem-workspace",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm build:shared && pnpm build:native && pnpm --filter @trackem/desktop dev",
    "dev:website": "pnpm --filter @trackem/website dev",
    "build:shared": "pnpm --filter @trackem/contracts build && pnpm --filter @trackem/core build",
    "build:native": "node scripts/native.mjs build",
    "test:native": "node scripts/native.mjs test",
    "build": "pnpm build:shared && pnpm --filter @trackem/desktop build && pnpm --filter @trackem/website build && pnpm build:native",
    "build:electron": "pnpm build:shared && pnpm --filter @trackem/desktop build:electron",
    "build:renderer": "pnpm build:shared && pnpm --filter @trackem/desktop build:renderer",
    "start": "pnpm --filter @trackem/desktop start",
    "lint": "biome lint .",
    "typecheck": "pnpm build:shared && pnpm --filter @trackem/ui typecheck && pnpm --filter @trackem/desktop typecheck && pnpm --filter @trackem/website typecheck",
    "test": "vitest run && pnpm test:native",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dist": "pnpm build && pnpm --filter @trackem/desktop dist",
    "dist:mac": "pnpm build && pnpm --filter @trackem/desktop dist:mac",
    "dist:win": "pnpm build && pnpm --filter @trackem/desktop dist:win"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "@types/node": "^22.20.2"
  }
}
