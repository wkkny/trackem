{
  "name": "trackem",
  "version": "0.1.0",
  "description": "A native menu bar and system tray monitor for Codex usage.",
  "main": "electron/dist/main.js",
  "private": true,
  "author": "Trackem",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/platform.mjs dev",
    "dev:mac": "swift run --package-path macos Trackem",
    "dev:win": "pnpm build:electron && electron .",
    "build": "node scripts/platform.mjs build",
    "build:electron": "node scripts/build-electron.mjs",
    "build:mac": "swift build --package-path macos -c release",
    "lint": "biome lint electron scripts package.json",
    "typecheck": "tsc --noEmit -p electron/tsconfig.json && tsc -p electron/tsconfig.test.json",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dist": "node scripts/platform.mjs dist",
    "dist:mac": "sh scripts/build-macos-app.sh",
    "dist:win": "pnpm build:electron && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.trackem.app",
    "productName": "Trackem",
    "files": [
      "electron/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Trackem"
    }
  },
  "dependencies": {},
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^22.20.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
