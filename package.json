{
  "name": "trackem",
  "version": "0.1.0",
  "description": "A system tray usage monitor for AI subscriptions.",
  "private": true,
  "author": "Trackem",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite --host",
    "build": "tauri build --no-bundle",
    "build:renderer": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "tauri dev",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dist": "tauri build",
    "dist:mac": "tauri build --bundles app,dmg",
    "dist:win": "tauri build --bundles nsis"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.44.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "shadcn": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
